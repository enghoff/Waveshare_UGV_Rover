calibration_backup_*.json
omni_bench/runs/

# lidar_slam/ is compiled per-machine on the armv6 Pi that runs it; a committed
# binary could only ever be for the wrong architecture.
lidar_slam/libslam2d.so
lidar_slam/selftest
*.pgm

# Measured on a particular rover by driving it -- the gyro's scale and the
# wheels' counts per metre. Belongs to the machine, not the repository, and
# lives beside ~/ugv so no deploy can overwrite it. See lidar_slam/odometry.py.
odometry.json

# netprobe writes its record of what the rover looked like from a desk here.
# It is evidence about one afternoon on one network, not source.
netwatch/*.log
