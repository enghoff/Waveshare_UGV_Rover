{
  "version": 1,
  "hosts": {
    "orin": {
      "ssh": "orin",
      "state_file": "~/.ugv/deploy-state.json"
    }
  },
  "components": [
    {
      "name": "world_state",
      "host": "orin",
      "destination": "~/ugv/world_state",
      "prune": false,
      "preserve": [
        "vendor/",
        "*.log"
      ],
      "sources": [
        {
          "patterns": [
            "world_state/**"
          ],
          "strip": "world_state"
        }
      ],
      "commands": [
        "cd ~/ugv/world_state && python3 selftest.py | tail -2",
        "test -f ~/ugv/world_state/vendor/Cosmos-Reason2-2B-Q4_K_M.gguf && test -f ~/ugv/world_state/vendor/mmproj-Cosmos-Reason2-2B-F16.gguf && test -x ~/ugv/world_state/vendor/llama/llama-server || { echo 'no model installed -- run ~/ugv/world_state/install.sh' >&2; exit 1; }",
        "~/ugv/world_state/restart.sh"
      ],
      "special_commands": [
        {
          "when": [
            "world_state/run_cosmos.sh"
          ],
          "replaces": [
            "~/ugv/world_state/restart.sh"
          ],
          "commands": [
            "~/ugv/world_state/restart.sh --supervisor"
          ]
        }
      ],
      "triggers": [
        "deploy/manifest.json"
      ]
    },
    {
      "name": "rover_daemon",
      "host": "orin",
      "destination": "~/ugv",
      "prune": false,
      "sources": [
        {
          "patterns": [
            "rover_daemon/*.py",
            "rover_daemon/*.sh"
          ],
          "strip": "rover_daemon"
        },
        {
          "patterns": [
            "driver_board/*.py"
          ],
          "strip": "driver_board"
        },
        {
          "patterns": [
            "face_tracking/*.py",
            "face_tracking/*.sh",
            "face_tracking/*.onnx"
          ],
          "strip": "face_tracking"
        }
      ],
      "commands": [
        "cd ~/ugv && python3 selftest.py | tail -2",
        "~/ugv/restart.sh",
        "python3 -c \"import json,socket; s=socket.create_connection(('127.0.0.1',8769),3); f=s.makefile('rwb'); f.write(b'{\\\"call\\\":\\\"list_tools\\\"}\\n'); f.flush(); r=json.loads(f.readline()); assert r.get('ok'), r; print('daemon:', len(r.get('tools',[])), 'tools')\"",
        "python3 -c \"import json,socket; s=socket.create_connection(('127.0.0.1',8769),5); f=s.makefile('rwb'); f.write(b'{\\\"call\\\":\\\"world_state_summary\\\"}\n'); f.flush(); r=json.loads(f.readline()); assert r.get('ok'), r; print('world:', r['summary']['entities'], 'entities,', r['summary']['observations'], 'observations,', r['backend'])\""
      ],
      "special_commands": [
        {
          "when": [
            "rover_daemon/run_daemon.sh"
          ],
          "replaces": [
            "~/ugv/restart.sh"
          ],
          "commands": [
            "pkill -f 'ugv/run_daemon[.]sh' || true; sleep 2; ~/ugv/restart.sh"
          ]
        }
      ],
      "triggers": [
        "deploy/manifest.json",
        "world_state/**"
      ]
    },
    {
      "name": "lidar_slam",
      "host": "orin",
      "destination": "~/ugv/lidar_slam",
      "prune": true,
      "preserve": [
        "libslam2d.so",
        "selftest"
      ],
      "sources": [
        {
          "patterns": [
            "lidar_slam/**"
          ],
          "strip": "lidar_slam"
        }
      ],
      "commands": [
        "cd ~/ugv/lidar_slam && ./build.sh && ./selftest | tail -2"
      ],
      "triggers": [
        "deploy/manifest.json"
      ]
    },
    {
      "name": "oak_depth",
      "host": "orin",
      "destination": "~/ugv/oak_depth",
      "prune": false,
      "preserve": [
        "vendor/",
        ".cache/",
        "*.log"
      ],
      "sources": [
        {
          "patterns": [
            "oak_depth/**"
          ],
          "strip": "oak_depth"
        }
      ],
      "commands": [
        "~/ugv/oak_depth/restart.sh"
      ],
      "special_commands": [
        {
          "when": [
            "oak_depth/run_oak_depth.sh"
          ],
          "replaces": [
            "~/ugv/oak_depth/restart.sh"
          ],
          "commands": [
            "~/ugv/oak_depth/restart.sh --supervisor"
          ]
        }
      ],
      "triggers": [
        "deploy/manifest.json"
      ]
    },
    {
      "name": "ros_nav",
      "host": "orin",
      "destination": "~/ugv/ros_nav",
      "prune": false,
      "preserve": [
        "*.log",
        "maps/",
        "recordings/"
      ],
      "sources": [
        {
          "patterns": [
            "ros_nav/**"
          ],
          "strip": "ros_nav"
        }
      ],
      "commands": [
        "~/ugv/ros_nav/behaviors/build.sh",
        "~/ugv/ros_nav/restart.sh"
      ],
      "special_commands": [
        {
          "when": [
            "ros_nav/run_ros_nav.sh",
            "ros_nav/sweep.sh",
            "ros_nav/dds.sh",
            "ros_nav/cyclonedds-loopback.xml"
          ],
          "replaces": [
            "~/ugv/ros_nav/restart.sh"
          ],
          "commands": [
            "~/ugv/ros_nav/restart.sh --supervisor"
          ]
        }
      ],
      "triggers": [
        "deploy/manifest.json"
      ]
    },
    {
      "name": "drive_web",
      "host": "orin",
      "destination": "~/ugv/drive_web",
      "prune": false,
      "sources": [
        {
          "patterns": [
            "drive_web/*.py",
            "drive_web/*.html",
            "drive_web/*.sh",
            "drive_web/README.md"
          ],
          "strip": "drive_web"
        },
        {
          "patterns": [
            "voice_chat/console_model.py",
            "voice_chat/rover_tools.py",
            "voice_chat/session.py",
            "voice_chat/talk_frames.py",
            "voice_chat/prompts.py"
          ],
          "strip": "voice_chat"
        }
      ],
      "commands": [
        "~/ugv/drive_web/restart.sh"
      ],
      "special_commands": [
        {
          "when": [
            "drive_web/run_drive_web.sh"
          ],
          "replaces": [
            "~/ugv/drive_web/restart.sh"
          ],
          "commands": [
            "pkill -f 'drive_web/run_drive_web[.]sh' || true; sleep 2; ~/ugv/drive_web/restart.sh"
          ]
        }
      ],
      "triggers": [
        "deploy/manifest.json"
      ]
    },
    {
      "name": "wifi_roam",
      "host": "orin",
      "destination": "~/ugv/wifi_roam",
      "prune": false,
      "sources": [
        {
          "patterns": [
            "wifi_roam/**"
          ],
          "strip": "wifi_roam"
        }
      ],
      "commands": [
        "sh ~/ugv/wifi_roam/selftest.sh | tail -1"
      ],
      "system_install": {
        "sudo_password_file": "secrets/jetson-orin.key",
        "command": "sh ~/ugv/wifi_roam/install.sh",
        "verify": [
          "/usr/local/sbin/wifi_ctl.sh status",
          "sudo -n /usr/local/sbin/wifi_ctl.sh profiles",
          "nmcli -t -f NAME,AUTOCONNECT,DEVICE con show | grep -E 'TheGreat|Maharaja'"
        ]
      },
      "triggers": [
        "deploy/manifest.json"
      ]
    },
    {
      "name": "dongle_driver",
      "host": "orin",
      "destination": "~/ugv/dongle_driver",
      "prune": false,
      "sources": [
        {
          "patterns": [
            "dongle_driver/**"
          ],
          "strip": "dongle_driver"
        }
      ],
      "commands": [],
      "system_install": {
        "sudo_password_file": "secrets/jetson-orin.key",
        "command": "sh ~/ugv/dongle_driver/install.sh",
        "verify": [
          "dkms status rtl8xxxu",
          "cat /sys/module/rtl8xxxu/parameters/rx_urb_recover",
          "nmcli -t -f DEVICE,TYPE,STATE dev | grep wifi"
        ]
      },
      "triggers": [
        "deploy/manifest.json"
      ]
    },
    {
      "name": "netwatch",
      "host": "orin",
      "destination": "~/ugv/netwatch",
      "prune": false,
      "sources": [
        {
          "patterns": [
            "netwatch/**"
          ],
          "strip": "netwatch"
        }
      ],
      "commands": [],
      "system_install": {
        "sudo_password_file": "secrets/jetson-orin.key",
        "command": "sh ~/ugv/netwatch/install.sh",
        "verify": [
          "systemctl is-active netwatch.service",
          "netwatch-report | tail -3"
        ]
      },
      "triggers": [
        "deploy/manifest.json"
      ]
    }
  ]
}
