# lidar_slam/ is compiled and run on the rover's Pi. Left to Windows' CRLF
# checkout, build.sh's shebang becomes "#!/usr/bin/env bash\r" and the kernel
# looks for an interpreter with a carriage return in its name -- which fails as
# "bad interpreter: No such file or directory", naming a file that plainly
# exists. gcc would accept CRLF in the C; the shell script will not.
lidar_slam/** text eol=lf

# oak_detect/ is compiled and run on the rover's Pi too -- build.sh has a shebang,
# and the vendored C would build fine with CRLF but the shell script would not.
oak_detect/** text eol=lf
oak_detect/*.mvcmd binary
oak_detect/*.blob binary

# docs/refs/ is vendor material kept verbatim -- a datasheet or a CAD export is
# evidence for numbers quoted elsewhere, and rewriting the line endings of a STEP
# file edits that evidence.
docs/refs/** -text

# wifi_roam/ is installed and run on the rover's Pi, and both shell scripts have
# shebangs -- a CRLF checkout would make the kernel look for an interpreter with a
# carriage return in its name, the same trap lidar_slam/build.sh fell into.
wifi_roam/** text eol=lf

# rover_daemon's supervisor scripts have shebangs and run on the rover host.
rover_daemon/*.sh text eol=lf
