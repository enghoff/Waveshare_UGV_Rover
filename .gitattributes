# lidar_slam/ is compiled and run on the rover's Pi. Left to Windows' CRLF
# checkout, build.sh's shebang becomes "#!/usr/bin/env bash\r" and the kernel
# looks for an interpreter with a carriage return in its name -- which fails as
# "bad interpreter: No such file or directory", naming a file that plainly
# exists. gcc would accept CRLF in the C; the shell script will not.
lidar_slam/** text eol=lf

# oak_depth/ runs on the rover and its three shell scripts have shebangs, so the
# same trap applies: a CRLF checkout makes the kernel look for an interpreter with
# a carriage return in its name. (oak_detect/ was here for the same reason until
# face detection moved onto the board's own cores; it is in the history.)
oak_depth/** text eol=lf

# docs/refs/ is vendor material kept verbatim -- a datasheet or a CAD export is
# evidence for numbers quoted elsewhere, and rewriting the line endings of a STEP
# file edits that evidence.
docs/refs/** -text

# wifi_roam/ is installed and run on the rover's Pi, and both shell scripts have
# shebangs -- a CRLF checkout would make the kernel look for an interpreter with a
# carriage return in its name, the same trap lidar_slam/build.sh fell into.
wifi_roam/** text eol=lf

# rover_daemon's supervisor scripts have shebangs and run on the rover host.
rover_daemon/*.sh text eol=lf

# drive_web/ is the rover-hosted console: supervisor, restart and crontab
# install all have shebangs, so a CRLF checkout would look for an interpreter
# with a carriage return in its name.
drive_web/** text eol=lf

# face_tracking/install_opencv.sh runs on the rover and has a shebang, and the
# wheel it unpacks is what the face detector imports -- a CRLF checkout would
# leave the rover unable to see rather than unable to build.
face_tracking/*.sh text eol=lf

# netwatch/ runs on the rover as root: install.sh has a shebang, and netwatch.py
# is installed into /usr/local/sbin and started by systemd from its own shebang.
# A CRLF checkout would leave the kernel looking for an interpreter with a
# carriage return in its name -- on the one program whose job is to still be
# working when everything else on the board has stopped.
netwatch/** text eol=lf

# ros_nav/ is ROS 2 on the rover: the installer, the supervisor and the launch
# wrappers all have shebangs, and the environment file they source is read by
# /bin/sh. The same carriage-return-in-the-interpreter-name trap, on the stack
# that drives the rover.
ros_nav/** text eol=lf

# ros_nav/fixtures/ is binary test material: the occupancy grid a recorded drive
# produced and a global costmap taken off the running planner, both gzipped,
# which frontier.py, explore_sim.py and plan_bench.py are argued against. The
# `ros_nav/** text eol=lf` rule above would rewrite bytes inside a gzip stream and
# leave a fixture that fails to decompress -- as a checkout problem, on one
# machine, which reads as a corrupt file in the repository.
ros_nav/fixtures/** -text

# It lives here rather than under ros_nav/recordings/ for a second reason worth
# writing down: `recordings/` is on that component's `preserve` list in
# deploy/manifest.json, so the deployer excludes it and nothing under it is ever
# copied to the rover. That is right for drives the rover recorded and wrong for a
# fixture the repository owns and the rover's own selftest needs.
