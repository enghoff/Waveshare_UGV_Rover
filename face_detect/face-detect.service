[Unit]
Description=Face detection service (YuNet, CPU)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/face_detect
# The LAN, not loopback: what calls this is a rover, and there is nobody sitting
# at MEDIA to open a tunnel for it. WSL's mirrored networking puts a Hyper-V
# firewall in front of this whose default inbound action is Block, so the port
# also needs a rule -- see the README.
Environment=FACE_HOST=0.0.0.0
Environment=FACE_PORT=8768
# Four threads for a 6.5 ms job -- where the measured curve flattens. This service
# exists to be concurrent with whichever model service owns the card, so it must
# not take the whole box to be quick at something that is already quick.
Environment=FACE_THREADS=4
ExecStart=/opt/face_detect/.venv/bin/python /opt/face_detect/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
