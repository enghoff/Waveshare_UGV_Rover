[Unit]
Description=Make sure the rover's wifi radio is switched on
Documentation=file:///home/admin/ugv/wifi_roam/README.md
# After all three, and requiring none of them. Which one is present is the whole
# difference between the two boards this runs on -- NetworkManager on the Pi,
# netplan's per-interface supplicant on the Banana Pi -- and an `After=` on a unit
# that does not exist is simply ignored, where the `Requires=NetworkManager` this
# used to carry made the unit fail outright on the board that is the rover now.
After=NetworkManager.service systemd-networkd.service wpa_supplicant.service

[Service]
Type=oneshot
# Both stacks keep the wifi radio's on/off switch somewhere that survives a
# reboot: NetworkManager in a state file of its own, netplan's in the rfkill state
# systemd saves and restores. So a radio that was switched off stays off across
# every reboot after -- by a hand at a console, or by the version of wifi_roam.sh
# that took the radio down and up and could be interrupted in between. On a rover
# whose only other way in is an ethernet cable, unplugged the moment it drives off
# and absent altogether on the Banana Pi, that is indistinguishable from a dead
# board, and there is no console to ask.
#
# So this asks for the radio on once per boot, before anything expects a network.
# It is idempotent and silent on a radio that is already on, which is every boot
# but the bad one, and it goes through wifi_ctl.sh because which command turns a
# radio on is exactly the kind of thing that differs between the two boards.
ExecStart=/usr/local/sbin/wifi_ctl.sh radio-on

[Install]
WantedBy=multi-user.target
