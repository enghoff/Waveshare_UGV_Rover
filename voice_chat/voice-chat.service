[Unit]
Description=Voice chat service (Whisper + Qwen3-VL-4B + Kokoro)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/voice_chat
# Bound to the LAN, not to loopback: the microphone now lives on the rover, and
# an SSH tunnel from a Pi 1 is a process and a reconnect loop we would rather not
# have between us and the conversation. The Hyper-V inbound rule opens 8765-8774
# for exactly this. There is no authentication on this port -- it is a trusted
# home LAN, and the same is already true of the face-detect service beside it.
Environment=VOICE_HOST=0.0.0.0
Environment=VOICE_PORT=8767
Environment=VOICE_DEVICE=cuda
# faster-whisper's CTranslate2 backend dlopens CUDA 12 at import, while torch
# 2.13 brings its own CUDA 13 -- so the card has the right driver but the wrong
# soname on the path, and STT fails with "libcublas.so.12 is not found" while
# the LLM and TTS are perfectly happy. The cu12 runtime wheels are installed
# alongside for this; the loader needs the path before the process starts, so it
# cannot be set from inside server.py.
Environment=LD_LIBRARY_PATH=/opt/voice_chat/.venv/lib/python3.11/site-packages/nvidia/cublas/lib:/opt/voice_chat/.venv/lib/python3.11/site-packages/nvidia/cudnn/lib
Environment=VOICE_STT_MODEL=Systran/faster-distil-whisper-large-v3
Environment=VOICE_TTS_VOICE=af_heart
# The reply model, and whether it can be shown a picture. These two go together:
# VOICE_VISION=1 needs a model with a vision tower and refuses to start without
# one, and the text model with VOICE_VISION=0 is this service as it was before
# any of it existed. Both are in the HF cache on this box, so switching between
# them costs a restart and nothing else -- which is the rollback:
#
#     VOICE_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507 and VOICE_VISION=0
#
Environment=VOICE_LLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
Environment=VOICE_VISION=1
# The vision tower stays in bf16 (see VOICE_INT4_SKIP in server.py): quantizing
# it costs prefill on every picture to speed up a token loop it has no part in.
# It is worth ~0.6GB, and it is the first thing to give back if the three models
# no longer fit the card together -- set VOICE_INT4_SKIP= to quantize it too.
Environment=VOICE_INT4_SKIP=visual
# Same int4 + static-cache + CUDA-graph recipe as qwen3-vl.service; see the
# comments in that unit and in server.py for the measurements. Compilation costs
# ~20s on top of the load, during which /health reports loaded:false. Unlike the
# vision service this one degrades to eager if compilation fails rather than
# refusing to start -- a slow assistant is still an assistant.
Environment=VOICE_LLM_QUANT=int4
# 3072 rather than the 2048 the text model ran in: a picture costs a few hundred
# tokens of this window and the conversation still has to fit around it. The
# cache is allocated whole and attention runs over all of it every step, so this
# is not free -- it is ~150MB and a slightly slower token, bought to keep a
# conversation from being trimmed to nothing the moment it looks at something.
Environment=VOICE_CACHE_LEN=3072
Environment=VOICE_COMPILE=1
ExecStart=/opt/voice_chat/.venv/bin/python /opt/voice_chat/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
